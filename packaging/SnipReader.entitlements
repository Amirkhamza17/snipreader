<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (needed for notarization) blocks Apple Events unless allowed:
	     "Launch at Login" asks System Events to add/remove the login item. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
